# Copy to local-dev/access.env and `set -a; source local-dev/access.env; set +a`
# LOCAL ONLY. Never use these values in AWS.
ACCESS_DB_HOST=127.0.0.1
ACCESS_DB_PORT=3307
ACCESS_DB_USER=root
ACCESS_DB_PASSWORD=localdev-root-pw
ACCESS_DB_NAME=in4mdatabase
# >= 32 bytes. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_JWT_SECRET=replace-with-48-random-bytes-base64url-xxxxxxxxxxxxxxxx
# Link HMAC key ring (same value goes to the subscriptionServer as ACCESS_LINK_SECRET locally).
ACCESS_LINK_SECRET='{"activeKid":"k1","keys":{"k1":"replace-with-48-random-bytes-base64url-yyyyyyyyyyyyyyyy"}}'

# Short session so renewal is observable in minutes. Link tokens are day-granular:
# test rotation/expiry with `access-admin.ts mint --issued <YYYY-MM-DD>` (61 / 91 days ago).
ACCESS_SESSION_TTL=3m
ACCESS_APP_BASE_URL=http://localhost:5173
